{
  "headers": [
    {
      "source": "/pantalla",
      "headers": [
        { "key": "x-vercel-skip-challenge", "value": "1" }
      ]
    },
    {
      "source": "/pantalla/(.*)",
      "headers": [
        { "key": "x-vercel-skip-challenge", "value": "1" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],
  "functions": {
    "api/generarFoto.js": {
      "maxDuration": 60
    },
    "api/borrarFotosViejas.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/borrarFotosViejas",
      "schedule": "0 8 * * *"
    }
  ]
}